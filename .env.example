# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ANTHROPIC_API_KEY: Server-side only (not VITE_-prefixed, never exposed to the browser).
# Used by server.ts's /api/event-chat route to power the guided event-prep chatbot.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# OPENAI_API_KEY: Server-side only (not VITE_-prefixed, never exposed to the browser).
# Used by server.ts's /api/transcribe route to transcribe Voice Analyzer recordings via OpenAI's
# Whisper API (chosen over the browser's Web Speech API, which has no support on iOS Safari).
# Without this set, /api/transcribe returns a null transcript rather than failing.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# SUPABASE_SERVICE_ROLE_KEY: Server-side only (never VITE_-prefixed, never exposed to the
# browser). Find it in Supabase dashboard -> Project Settings -> API -> service_role key.
# Used by server.ts's /api/delete-account route to delete a user's own auth account (which
# cascades to every user-owned table via the ON DELETE CASCADE foreign keys in
# supabase/schema.sql). Without this set, account deletion is disabled server-side.
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# HUME_API_KEY: Server-side only (never VITE_-prefixed, never exposed to the browser).
# Used by server.ts's /api/hume-delivery route for the optional "Expressive Delivery" report
# section (Read Aloud + Free Speech only). Without this set, the route returns no attributes and
# the section simply doesn't appear.
HUME_API_KEY="MY_HUME_API_KEY"

# VOICE_ANALYSIS_URL: Base URL of the standalone voice-analysis-service (Praat acoustics).
# Used by server.ts's /api/voice-acoustics route. Defaults to http://localhost:8000 for local dev;
# set to the Railway URL in production. If unreachable, the acoustic section is simply omitted.
VOICE_ANALYSIS_URL="http://localhost:8000"
